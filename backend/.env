# =============================================================================
# Drone Control System Configuration
# =============================================================================
# WiFi-less configuration for telemetry radio communication
# Never commit .env to version control

# =============================================================================
# SITL Configuration (Gazebo/PX4)
# =============================================================================
# PX4 sends MAVLink heartbeats TO port 14540 (companion computer port)
SITL_HOST=127.0.0.1
SITL_PORT=14540

# =============================================================================
# Hardware Telemetry Configuration
# =============================================================================
# DIRECT connection to Pixhawk (NO MAVProxy needed!)
# Connect MAVSDK directly to Pixhawk via serial for stability
TELEMETRY_DEVICE=serial:///dev/ttyTHS1:115200
TELEMETRY_BAUDRATE=115200

# =============================================================================
# Velocity Limits
# =============================================================================
MAX_VELOCITY_HORIZONTAL=5.0
MAX_VELOCITY_VERTICAL=1.0
MAX_YAW_RATE=45.0

# =============================================================================
# Offboard Mode Configuration
# =============================================================================
OFFBOARD_SETPOINT_RATE_HZ=10.0
OFFBOARD_MIN_RATE_HZ=2.0
OFFBOARD_INIT_SETPOINT_DURATION=1.5
OFFBOARD_INIT_RETRY_ATTEMPTS=3
OFFBOARD_MODE_CHECK_INTERVAL=1.0

# =============================================================================
# Takeoff Configuration
# =============================================================================
DEFAULT_TAKEOFF_ALTITUDE=2.5
MIN_TAKEOFF_ALTITUDE=1.0
TAKEOFF_OFFBOARD_DELAY=8.0

# =============================================================================
# Hardware Mode Configuration
# =============================================================================
# Set to False for Gazebo/SITL simulation, True for real drone
HARDWARE_MODE=False
HARDWARE_TIMEOUT_MULTIPLIER=1.5

# =============================================================================
# Connection Health Monitoring
# =============================================================================
CONNECTION_MONITOR_INTERVAL=1.0
CONNECTION_LOSS_TIMEOUT=10.0
CONNECTION_RECONNECT_MAX_ATTEMPTS=5
CONNECTION_RECONNECT_BACKOFF_BASE=2.0

# =============================================================================
# Setpoint Streamer Configuration
# =============================================================================
SETPOINT_STREAMER_MAX_RESTARTS=5
SETPOINT_STREAMER_RESTART_BACKOFF=2.0
SETPOINT_STREAMER_RESTART_BACKOFF_MAX=10.0

# =============================================================================
# GPS Loss Handling
# =============================================================================
GPS_LOSS_ACTION=LAND
GPS_LOSS_TIMEOUT=5.0
GPS_MIN_SATELLITES=6
GPS_MIN_FIX_TYPE=3

# =============================================================================
# Telemetry Stream Configuration
# =============================================================================
TELEMETRY_STREAM_MAX_RESTARTS=3
TELEMETRY_STREAM_RESTART_BACKOFF=1.0
TELEMETRY_STALE_THRESHOLD=2.0

# =============================================================================
# State Synchronization
# =============================================================================
STATE_SYNC_INTERVAL=3.0
STATE_SYNC_MISMATCH_THRESHOLD=3

# =============================================================================
# Emergency Handling
# =============================================================================
EMERGENCY_ZERO_VELOCITY_ATTEMPTS=5
EMERGENCY_LAND_TIMEOUT=5.0

# =============================================================================
# Safety Limits
# =============================================================================
SAFETY_MAX_ALTITUDE=100.0
SAFETY_MAX_DISTANCE=500.0
SAFETY_MIN_BATTERY=0.0
SAFETY_BATTERY_WARNING=0.0

# =============================================================================
# LLM Integration Configuration
# =============================================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=30

# =============================================================================
# Debug / Testing Configuration
# =============================================================================
# Set to True to show detailed MAVLink command logs without executing
DRY_RUN_MODE=false
# Enhanced logging for mission executor
DEBUG_MISSION_EXECUTOR=true
# Enhanced logging for velocity controller
DEBUG_VELOCITY_COMMANDS=true
# Enhanced logging for MAVLink commands
DEBUG_MAVLINK_COMMANDS=true

# =============================================================================
# Demo / Presentation
# =============================================================================
DEMO_SAFETY_TRIGGER_AFTER_FIRST_WP=false

# =============================================================================
# Conversation Memory Configuration
# =============================================================================
CONVERSATION_MESSAGE_THRESHOLD=20
CONVERSATION_MESSAGES_TO_SUMMARIZE=12
CONVERSATION_MESSAGES_TO_KEEP=8
CONVERSATION_SUMMARY_MAX_TOKENS=500

# =============================================================================
# Mission Executor Configuration
# =============================================================================
WAYPOINT_POSITION_TOLERANCE=0.5
WAYPOINT_ALTITUDE_TOLERANCE=0.5
WAYPOINT_VELOCITY_TOLERANCE=0.1
WAYPOINT_NAVIGATION_KP=0.5
MAXIMUM_WAYPOINT_TIMEOUT=120.0
METERS_PER_DEGREE_LAT=111320

# =============================================================================
# Serial Communication (USB Telemetry Radio)
# =============================================================================
# Set to false for simulation (no serial hardware)
USE_SERIAL_COMM=false
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=57600