# =============================================================================
# Drone Control System Configuration
# =============================================================================
# Copy this file to .env and update values as needed
# Never commit .env to version control

# =============================================================================
# Connection Configuration
# =============================================================================
# For SITL (simulation): Use UDP connection
SITL_HOST=127.0.0.1
SITL_PORT=14540

# For Hardware (real drone): Use Serial connection
# Telemetry radio is usually /dev/ttyUSB0 or /dev/ttyACM0
TELEMETRY_DEVICE=/dev/ttyUSB0
TELEMETRY_BAUDRATE=57600

# =============================================================================
# Velocity Limits
# =============================================================================
MAX_VELOCITY_HORIZONTAL=5.0      # m/s - maximum horizontal velocity
MAX_VELOCITY_VERTICAL=1.0        # m/s - maximum vertical velocity
MAX_YAW_RATE=45.0                # deg/s - maximum yaw rotation rate

# =============================================================================
# Offboard Mode Configuration
# =============================================================================
OFFBOARD_SETPOINT_RATE_HZ=10.0           # Hz - setpoint streaming rate
OFFBOARD_MIN_RATE_HZ=2.0                 # Hz - PX4 minimum requirement
OFFBOARD_INIT_SETPOINT_DURATION=1.5      # seconds - duration to send setpoints before starting offboard
OFFBOARD_INIT_RETRY_ATTEMPTS=3           # number of retry attempts for offboard initialization
OFFBOARD_MODE_CHECK_INTERVAL=1.0         # seconds - check offboard mode health interval

# =============================================================================
# Takeoff Configuration
# =============================================================================
DEFAULT_TAKEOFF_ALTITUDE=2.5    # meters - default takeoff altitude
MIN_TAKEOFF_ALTITUDE=1.0        # meters - minimum allowed takeoff altitude
TAKEOFF_OFFBOARD_DELAY=3.0      # seconds - delay before offboard init after takeoff

# =============================================================================
# Hardware Mode Configuration
# =============================================================================
HARDWARE_MODE=False             # Set to True when using real hardware (not SITL)
HARDWARE_TIMEOUT_MULTIPLIER=1.5 # 50% longer timeouts for hardware

# =============================================================================
# Connection Health Monitoring
# =============================================================================
CONNECTION_MONITOR_INTERVAL=1.0          # seconds - connection check interval
CONNECTION_LOSS_TIMEOUT=3.0              # seconds - before connection considered lost
CONNECTION_RECONNECT_MAX_ATTEMPTS=5      # max auto-reconnection attempts
CONNECTION_RECONNECT_BACKOFF_BASE=2.0    # seconds - base backoff between reconnect attempts

# =============================================================================
# Setpoint Streamer Configuration
# =============================================================================
SETPOINT_STREAMER_MAX_RESTARTS=5         # max auto-restart attempts
SETPOINT_STREAMER_RESTART_BACKOFF=2.0    # seconds - base backoff between restarts
SETPOINT_STREAMER_RESTART_BACKOFF_MAX=10.0  # seconds - maximum backoff time

# =============================================================================
# GPS Loss Handling
# =============================================================================
GPS_LOSS_ACTION=LAND            # Options: "LAND", "RTL" (Return to Launch), "HOLD"
GPS_LOSS_TIMEOUT=5.0            # seconds - without GPS before failsafe action
GPS_MIN_SATELLITES=6            # minimum satellites for valid GPS fix
GPS_MIN_FIX_TYPE=3              # Options: 0=None, 2=2D Fix, 3=3D Fix (recommended)

# =============================================================================
# Telemetry Stream Configuration
# =============================================================================
TELEMETRY_STREAM_MAX_RESTARTS=3       # max auto-restart attempts per stream
TELEMETRY_STREAM_RESTART_BACKOFF=1.0  # seconds - backoff between restarts
TELEMETRY_STALE_THRESHOLD=2.0         # seconds - before data considered stale

# =============================================================================
# State Synchronization
# =============================================================================
STATE_SYNC_INTERVAL=3.0           # seconds - between backend/PX4 state syncs
STATE_SYNC_MISMATCH_THRESHOLD=3   # consecutive mismatches before corrective action

# =============================================================================
# Emergency Handling
# =============================================================================
EMERGENCY_ZERO_VELOCITY_ATTEMPTS=5   # retry attempts for zero velocity command
EMERGENCY_LAND_TIMEOUT=5.0           # seconds - timeout for emergency land command

# =============================================================================
# Safety Limits
# =============================================================================
SAFETY_MAX_ALTITUDE=100.0        # meters - maximum altitude above home
SAFETY_MAX_DISTANCE=500.0        # meters - maximum distance from home (geofence)
SAFETY_MIN_BATTERY=20.0          # percentage - critical battery level (triggers auto-land)
SAFETY_BATTERY_WARNING=25.0      # percentage - warning battery level

# =============================================================================
# LLM Integration Configuration
# =============================================================================

# LLM Provider Selection
LLM_PROVIDER=local   # "gemini", "openai", or "local"

# Google Gemini Configuration
GEMINI_API_KEY=AIzaSyCDbwigGMGgOrW3d-4kNv25nBBmjAgh49k
GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI Configuration (for future use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Model Configuration (Qwen2-0.5B fine-tuned)
LOCAL_MODEL_PATH=e:/hire/auto-main/drone_model/drone_model/drone-commander-qwen-lora-merged

# LLM Parameters
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=30

# =============================================================================
# Demo / Presentation
# =============================================================================
# Set to true to trigger safety re-eval (EVALUATE_MISSION path) after first waypoint
# completes. Use only for demos; leave false for normal operation.
DEMO_SAFETY_TRIGGER_AFTER_FIRST_WP=false

# =============================================================================
# Conversation Memory Configuration
# =============================================================================
CONVERSATION_MESSAGE_THRESHOLD=20  # Trigger summarization when message count exceeds this
CONVERSATION_MESSAGES_TO_SUMMARIZE=12 # Number of older messages to summarize
CONVERSATION_MESSAGES_TO_KEEP=8   # Number of recent messages to keep in full
CONVERSATION_SUMMARY_MAX_TOKENS=500   # Maximum tokens for the summary response


# =============================================================================
# Mission Executor Configuration
# =============================================================================

WAYPOINT_POSITION_TOLERANCE=0.5  # meters
WAYPOINT_ALTITUDE_TOLERANCE=0.5  # meters
WAYPOINT_VELOCITY_TOLERANCE=0.1  # m/s
WAYPOINT_NAVIGATION_KP=0.5       # proportional gain
MAXIMUM_WAYPOINT_TIMEOUT=120.0
METERS_PER_DEGREE_LAT=111320